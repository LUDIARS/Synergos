{
  "layers": [
    { "glob": "synergos-core/native/tests/**", "layer": "application" },
    { "glob": "synergos-custody/native/tests/**", "layer": "application" },
    { "glob": "synergos-ipc/native/tests/**", "layer": "application" },
    { "glob": "synergos-net/native/trust/tests/**", "layer": "application" },
    { "glob": "fuzz/**", "layer": "application" },
    { "glob": "scripts/gate/**", "layer": "application" },
    { "glob": "synergos-core/native/*.cpp", "layer": "domain" },
    { "glob": "synergos-core/native/include/**", "layer": "domain" },
    { "glob": "synergos-net/native/trust/*.cpp", "layer": "domain" },
    { "glob": "synergos-net/native/trust/*.h", "layer": "domain" },
    { "glob": "synergos-net/native/trust/include/**", "layer": "domain" },
    { "glob": "synergos-ipc/native/*.cpp", "layer": "infrastructure" },
