/target
/build-native/
/build-fuzz/

# synergos-control のレジストリ (組織メンバーのメール / node key ハッシュを含む)
# と、そこから生成される一時ファイル・実運用設定をリポジトリに入れない。
synergos-control-store.json
synergos-control-store.*.tmp
/control.toml
/.revisor-version
/.concordia-commit.json

# Synergos project-local runtime data. manifest.json remains intentionally trackable.
.synergos/incoming/
.synergos/history/
.synergos/state.json

# Anatomia のローカル状態。層宣言だけを追跡し、業務ドメイン正本は spec/domains/ に置く。
.anatomia/*
!.anatomia/layers.json

# synergos-admin-ui は独立 workspace のため、その target は root の /target に含まれない
/synergos-admin-ui/target
/synergos-admin-ui/dist
/synergos-admin-ui/.dioxus

# Excubitor site 運用のデータ (レジストリ・custody 保管物・生成した control.toml)
/data/site/
